                "generateName": "edgeai-influxdb-restore-check-20261013-",
                "labels": {
                    "app.kubernetes.io/part-of": "edgeai",
                    "batch.kubernetes.io/controller-uid": "86963c05-08e1-4cd1-82e6-1aa003055435",
                    "batch.kubernetes.io/job-name": "edgeai-influxdb-restore-check-20261013",
