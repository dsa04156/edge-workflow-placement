                        "command": [
                            "/bin/sh",
                            "-ec",
                            "set -eu\numask 077\nexport PGDATABASE=postgres PGOPTIONS='-c timezone=UTC'\ndb=edgeai_restore_hdd_verify_20261013\ntrap 'dropdb --if-exists \"$db\"' EXIT HUP INT TERM\ncreatedb --template=template0 --locale=C --encoding=UTF8 \"$db\"\nlatest=$(ls -1d /backups/20??????T??????Z | sort -r | head -n 1)\ntest -f \"$latest/.complete\"\n(cd \"$latest\" \u0026\u0026 sha256sum -c SHA256SUMS)\npg_restore --exit-on-error --no-owner --no-acl --dbname=\"$db\" \"$latest/edgeai.dump\"\npsql -X -v ON_ERROR_STOP=1 -At -d \"$db\" -f /verify/schema-check.sql\nprintf 'PostgreSQL HDD backup restore verified\\n'\n"
                        ],
                        "env": [
                            {
                                "name": "PGHOST",
                                "value": "edgeai-postgres-hdd"
                            },
