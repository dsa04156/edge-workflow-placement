                },
                "name": "edgeai-influxdb-restore-check-20261013-2hz42",
                "namespace": "edgeai",
                "ownerReferences": [
                    {
                        "apiVersion": "batch/v1",
                        "blockOwnerDeletion": true,
                        "controller": true,
                        "kind": "Job",
                        "name": "edgeai-influxdb-restore-check-20261013",
                        "uid": "86963c05-08e1-4cd1-82e6-1aa003055435"
