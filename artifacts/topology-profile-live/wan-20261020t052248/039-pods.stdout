                            "tcpSocket": {
                                "port": "mqtts"
                            },
                            "timeoutSeconds": 1
                        },
                        "name": "mosquitto",
                        "ports": [
                            {
                                "containerPort": 8883,
                                "name": "mqtts",
                                "protocol": "TCP"
                            }
                        ],
                        "readinessProbe": {
                            "failureThreshold": 3,
                            "periodSeconds": 5,
                            "successThreshold": 1,
                            "tcpSocket": {
                                "port": "mqtts"
                            },
                            "timeoutSeconds": 1
