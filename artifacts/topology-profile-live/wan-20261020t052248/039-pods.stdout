                "automountServiceAccountToken": false,
                "containers": [
                    {
                        "command": [
                            "sh",
                            "-ec",
                            "umask 077\ncd /mosquitto/data\nif [ ! -f dynamic-security.json ]; then\n  test ! -e .initialized\n  test ! -e mosquitto.db\n  cp /bootstrap/dynamic-security.json .dynamic-security.initial\n  chmod 600 .dynamic-security.initial\n  mv .dynamic-security.initial dynamic-security.json\nfi\ntest -s dynamic-security.json\ntest ! -L dynamic-security.json\ntouch .initialized\nexec /usr/sbin/mosquitto -c /config/mosquitto.conf\n"
                        ],
                        "image": "eclipse-mosquitto:2@sha256:38c0da4f2ef84284d47b3b3eeea1cb3bdeabe81ee10caf0cd5c5ff61ee3ea408",
                        "imagePullPolicy": "IfNotPresent",
