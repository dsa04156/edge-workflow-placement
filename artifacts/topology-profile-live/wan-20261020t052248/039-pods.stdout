                "uid": "581ac015-568f-477e-bfd5-d64a108933ab"
            },
            "spec": {
                "automountServiceAccountToken": false,
                "containers": [
                    {
                        "command": [
                            "/bin/sh",
                            "-ec",
                            "set -eu\numask 077\nexport HOME=/tmp INFLUX_CONFIGS_PATH=/tmp/influx-config\ndir=/backups/restore-check-20261013\ntest ! -e \"$dir\"\nmkdir \"$dir\"\ninfluxd --http-bind-address=:18087 --engine-path=\"$dir/engine\" --bolt-path=\"$dir/influxd.bolt\" --sqlite-path=\"$dir/influxd.sqlite\" --reporting-disabled=true \u003e /tmp/restore-server.log 2\u003e\u00261 \u0026\nserver=$!\ntrap 'kill -TERM \"$server\" 2\u003e/dev/null || true; wait \"$server\" 2\u003e/dev/null || true' EXIT HUP INT TERM\ni=0\nuntil wget -q -O /tmp/health http://127.0.0.1:18087/health; do i=$((i+1)); test \"$i\" -lt 60; sleep 1; done\n# printf is a shell builtin; neither token nor password enters external process arguments.\npassword=$(head -c 32 /dev/urandom | base64)\nprintf '{\"username\":\"edgeai-restore-check\",\"password\":\"%s\",\"org\":\"restore-check\",\"bucket\":\"restore-check\",\"token\":\"%s\"}' \"$password\" \"$INFLUX_TOKEN\" \u003e /tmp/setup.json\nwget -q -O /tmp/setup-response --header='Content-Type: application/json' --post-file=/tmp/setup.json http://127.0.0.1:18087/api/v2/setup\nrm /tmp/setup.json /tmp/setup-response\nlatest=$(ls -1d /backups/20??????T??????Z | sort -r | head -n 1)\ntest -f \"$latest/.complete\"\n(cd \"$latest\" \u0026\u0026 sha256sum -c SHA256SUMS)\ninflux restore --host http://127.0.0.1:18087 --full \"$latest/data\"\ninflux query --host http://127.0.0.1:18087 --org edgeai --raw 'from(bucket:\"sensor-originals\") |\u003e range(start:1970-01-01T00:00:00Z) |\u003e group(columns:[\"_measurement\",\"_field\"]) |\u003e count() |\u003e sort(columns:[\"_measurement\",\"_field\"])'\ndf -PT \"$dir\"\nprintf 'Influx HDD full backup restore verified\\n'\n"
                        ],
                        "env": [
                            {
                                "name": "INFLUX_TOKEN",
                                "valueFrom": {
                                    "secretKeyRef": {
                                        "key": "token",
                                        "name": "edgeai-influxdb-admin"
                                    }
                                }
                            }
                        ],
                        "image": "public.ecr.aws/docker/library/influxdb@sha256:f551adeb94b6f97626d2043ec90ed17f81de18d15bb5412d2101e0965c93c797",
