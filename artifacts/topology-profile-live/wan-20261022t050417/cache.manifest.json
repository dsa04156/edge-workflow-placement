{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "wan-20261022t050417-cache",
        "namespace": "topology-profile-lab",
        "labels": {
          "experiment": "topology-profile",
          "run-id": "wan-20261022t050417"
        }
      },
      "spec": {
        "schedulerName": "default-scheduler",
        "automountServiceAccountToken": false,
        "restartPolicy": "Never",
        "activeDeadlineSeconds": 10800,
        "terminationGracePeriodSeconds": 3,
        "securityContext": {
          "fsGroup": 65532
        },
        "affinity": {
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchFields": [
                    {
                      "key": "metadata.name",
                      "operator": "In",
                      "values": [
                        "etri-ser0002-cgnmsb"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "containers": [
          {
            "name": "worker",
            "image": "10.254.192.47:5000/node-inventory-python@sha256:370a8339507905053693d178e1cda8fbf77937f045ead58a3c32d8cead2ca67f",
            "imagePullPolicy": "IfNotPresent",
            "command": [
              "python3",
              "-u",
              "-m",
              "http.server",
              "8080",
              "--directory",
              "/work"
            ],
            "env": [
              {
                "name": "NODE_NAME",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "spec.nodeName"
                  }
                }
              },
              {
                "name": "POD_UID",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "metadata.uid"
                  }
                }
              },
              {
                "name": "TASK_ID",
                "value": "cache"
              },
              {
                "name": "TMPDIR",
                "value": "/work/tmp"
              },
              {
                "name": "PYTHONDONTWRITEBYTECODE",
                "value": "1"
              },
              {
                "name": "HF_HUB_OFFLINE",
                "value": "1"
              },
              {
                "name": "TRANSFORMERS_OFFLINE",
                "value": "1"
              }
            ],
            "volumeMounts": [
              {
                "name": "work",
                "mountPath": "/work"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "256Mi",
                "ephemeral-storage": "128Mi"
              },
              "limits": {
                "cpu": "1",
                "memory": "512Mi",
                "ephemeral-storage": "8Gi"
              }
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/",
                "port": 8080
              },
              "periodSeconds": 5,
              "timeoutSeconds": 3
            },
            "securityContext": {
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "runAsNonRoot": true,
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            }
          }
        ],
        "volumes": [
          {
            "name": "work",
            "emptyDir": {
              "sizeLimit": "8Gi"
            }
          }
        ]
      }
    }
  ]
}
