    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "labels": {
          "experiment": "sensehat-placement",
          "group": "pool",
          "role": "source",
          "run-id": "sensehat-20261021t114702z"
        },
        "name": "sensehat-20261021t114702z-src",
        "namespace": "topology-profile-lab"
      },
      "spec": {
        "activeDeadlineSeconds": 1800,
        "affinity": {
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchFields": [
                    {
                      "key": "metadata.name",
                      "operator": "In",
                      "values": [
                        "etri-dev0003-raspi5"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "automountServiceAccountToken": false,
        "containers": [
          {
            "command": [
              "python3",
              "-u",
              "/config/stage_runtime.py",
              "serve"
            ],
            "env": [
              {
                "name": "NODE_NAME",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "spec.nodeName"
                  }
                }
              },
              {
                "name": "POD_UID",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "metadata.uid"
                  }
                }
              },
              {
                "name": "TASK_ID",
                "value": "source"
              },
              {
                "name": "CONFIG_ROOT",
                "value": "/config"
              },
              {
                "name": "PYTHONDONTWRITEBYTECODE",
                "value": "1"
              }
            ],
            "image": "192.168.0.56:5000/node-inventory-python@sha256:370a8339507905053693d178e1cda8fbf77937f045ead58a3c32d8cead2ca67f",
            "imagePullPolicy": "IfNotPresent",
            "name": "worker",
            "ports": [
              {
                "containerPort": 8080
              }
            ],
            "readinessProbe": {
              "httpGet": {
                "path": "/health",
                "port": 8080
              },
              "initialDelaySeconds": 1,
              "periodSeconds": 2,
              "timeoutSeconds": 2
            },
            "resources": {
              "limits": {
                "cpu": "500m",
                "memory": "128Mi"
              },
              "requests": {
                "cpu": "100m",
                "memory": "64Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true
            },
            "volumeMounts": [
              {
                "mountPath": "/config",
                "name": "config",
                "readOnly": true
              }
            ]
          }
        ],
        "enableServiceLinks": false,
        "restartPolicy": "Never",
        "schedulerName": "default-scheduler",
        "securityContext": {
          "runAsGroup": 65532,
          "runAsNonRoot": true,
          "runAsUser": 65532
        },
        "terminationGracePeriodSeconds": 3,
        "volumes": [
          {
            "configMap": {
              "name": "sensehat-20261021t114702z"
            },
            "name": "config"
          }
        ]
      }
    },
