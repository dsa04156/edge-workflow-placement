                        "value": "2"
                    },
                    {
                        "name": "OPENBLAS_NUM_THREADS",
                        "value": "1"
                    },
                    {
                        "name": "ROLE",
                        "value": "worker"
                    },
                    {
                        "name": "ASSET_URL",
                        "value": "http://10.244.8.130:8080"
                    },
                    {
                        "name": "TASK_ID",
                        "value": "V"
                    },
                    {
                        "name": "THREADS",
                        "value": "2"
