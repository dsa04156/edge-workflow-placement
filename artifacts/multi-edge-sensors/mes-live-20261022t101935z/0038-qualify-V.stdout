                        "valueFrom": {
                            "fieldRef": {
                                "apiVersion": "v1",
                                "fieldPath": "status.podIP"
                            }
                        }
                    },
                    {
                        "name": "TMPDIR",
                        "value": "/work/tmp"
                    },
                    {
                        "name": "PORT",
                        "value": "8080"
                    },
                    {
                        "name": "PYTHONDONTWRITEBYTECODE",
                        "value": "1"
                    },
                    {
