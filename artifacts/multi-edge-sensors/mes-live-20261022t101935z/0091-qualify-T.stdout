                        "valueFrom": {
                            "fieldRef": {
                                "apiVersion": "v1",
                                "fieldPath": "status.podIP"
                            }
                        }
                    },
                    {
                        "name": "TMPDIR",
                        "value": "/work/tmp"
                    },
                    {
                        "name": "PORT",
                        "value": "8080"
                    },
                    {
                        "name": "PYTHONDONTWRITEBYTECODE",
                        "value": "1"
                    },
                    {
                        "name": "OMP_NUM_THREADS",
                        "value": "1"
                    },
                    {
                        "name": "OPENBLAS_NUM_THREADS",
                        "value": "1"
                    },
                    {
                        "name": "ROLE",
                        "value": "worker"
                    },
                    {
                        "name": "ASSET_URL",
                        "value": "http://10.244.8.130:8080"
                    },
                    {
                        "name": "TASK_ID",
                        "value": "T"
                    },
                    {
                        "name": "THREADS",
                        "value": "1"
                    }
                ],
