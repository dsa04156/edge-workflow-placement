                        {
                            "matchFields": [
                                {
                                    "key": "metadata.name",
                                    "operator": "In",
                                    "values": [
                                        "etri-dev0003-raspi5"
                                    ]
                                }
                            ]
                        }
                    ]
                }
            }
        },
        "automountServiceAccountToken": false,
        "containers": [
            {
                "command": [
                    "python3",
                    "-u",
                    "-c",
                    "import os,runpy;os.makedirs('/work/tmp',exist_ok=True);runpy.run_path('/config/bootstrap.py',run_name='__main__')"
                ],
                "env": [
                    {
