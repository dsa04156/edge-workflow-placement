                "volumeMounts": [
                    {
                        "mountPath": "/work",
                        "name": "work"
                    },
                    {
                        "mountPath": "/config",
                        "name": "config",
                        "readOnly": true
                    }
                ]
            }
        ],
        "dnsPolicy": "ClusterFirst",
        "enableServiceLinks": false,
        "preemptionPolicy": "PreemptLowerPriority",
        "priority": 0,
        "restartPolicy": "Never",
        "schedulerName": "default-scheduler",
