                    },
                    {
                        "name": "POD_IP",
                        "valueFrom": {
                            "fieldRef": {
                                "apiVersion": "v1",
                                "fieldPath": "status.podIP"
                            }
                        }
                    },
                    {
                        "name": "TMPDIR",
                        "value": "/work/tmp"
                    },
                    {
                        "name": "PORT",
                        "value": "8080"
                    },
                    {
                        "name": "PYTHONDONTWRITEBYTECODE",
                        "value": "1"
                    },
                    {
                        "name": "OMP_NUM_THREADS",
                        "value": "2"
                    },
                    {
                        "name": "OPENBLAS_NUM_THREADS",
                        "value": "1"
                    },
                    {
                        "name": "ROLE",
                        "value": "worker"
                    },
                    {
                        "name": "ASSET_URL",
                        "value": "http://10.244.8.154:8080"
                    },
                    {
                        "name": "TASK_ID",
                        "value": "V"
                    },
                    {
                        "name": "THREADS",
                        "value": "2"
                    }
                ],
                "image": "10.254.192.47:5000/node-inventory-python@sha256:370a8339507905053693d178e1cda8fbf77937f045ead58a3c32d8cead2ca67f",
                "imagePullPolicy": "IfNotPresent",
                "name": "worker",
                "readinessProbe": {
                    "failureThreshold": 3,
                    "httpGet": {
                        "path": "/health",
                        "port": 8080,
                        "scheme": "HTTP"
                    },
                    "initialDelaySeconds": 2,
                    "periodSeconds": 3,
                    "successThreshold": 1,
                    "timeoutSeconds": 3
                },
                "resources": {
                    "limits": {
                        "cpu": "2",
                        "ephemeral-storage": "3Gi",
                        "memory": "1536Mi"
                    },
                    "requests": {
                        "cpu": "2",
                        "ephemeral-storage": "512Mi",
                        "memory": "1536Mi"
                    }
                },
                "securityContext": {
                    "allowPrivilegeEscalation": false,
                    "capabilities": {
                        "drop": [
                            "ALL"
                        ]
                    },
                    "readOnlyRootFilesystem": true
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                    {
                        "mountPath": "/work",
                        "name": "work"
                    },
                    {
                        "mountPath": "/config",
                        "name": "config",
                        "readOnly": true
                    }
                ]
            }
        ],
        "dnsPolicy": "ClusterFirst",
        "enableServiceLinks": false,
        "preemptionPolicy": "PreemptLowerPriority",
        "priority": 0,
        "restartPolicy": "Never",
        "schedulerName": "default-scheduler",
        "securityContext": {
            "fsGroup": 65532,
