                "key": "node.kubernetes.io/unreachable",
                "operator": "Exists",
                "tolerationSeconds": 300
            }
        ],
        "volumes": [
            {
                "emptyDir": {
                    "sizeLimit": "3Gi"
                },
                "name": "work"
            },
            {
                "configMap": {
                    "defaultMode": 420,
                    "name": "mes-heavy-20261022t113349z-code"
                },
                "name": "config"
            }
