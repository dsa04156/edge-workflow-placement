  "items": [
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "labels": {
          "experiment": "sensehat-neural-smoke",
          "run-id": "nsmoke-20261022t025228z",
          "site": "edge"
        },
        "name": "nsmoke-20261022t025228z-edge",
        "namespace": "topology-profile-lab"
      },
      "spec": {
        "activeDeadlineSeconds": 360,
        "affinity": {
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchFields": [
                    {
                      "key": "metadata.name",
                      "operator": "In",
                      "values": [
                        "etri-dev0003-raspi5"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "automountServiceAccountToken": false,
        "containers": [
          {
            "command": [
              "python3",
              "-c",
              "import time; time.sleep(360)"
            ],
            "env": [
              {
                "name": "NODE_NAME",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "spec.nodeName"
                  }
                }
              },
              {
                "name": "POD_UID",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "metadata.uid"
                  }
                }
              },
              {
                "name": "PYTHONPATH",
                "value": "/work/site"
              },
              {
                "name": "PYTHONDONTWRITEBYTECODE",
                "value": "1"
              },
              {
                "name": "OMP_NUM_THREADS",
                "value": "1"
              },
              {
                "name": "OPENBLAS_NUM_THREADS",
                "value": "1"
              }
            ],
            "image": "192.168.0.56:5000/node-inventory-python@sha256:370a8339507905053693d178e1cda8fbf77937f045ead58a3c32d8cead2ca67f",
            "imagePullPolicy": "IfNotPresent",
            "name": "worker",
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "1Gi"
              },
              "requests": {
                "cpu": "1",
                "memory": "1Gi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "privileged": false,
              "readOnlyRootFilesystem": true
            },
            "volumeMounts": [
              {
                "mountPath": "/work",
                "name": "work"
              }
            ]
          }
        ],
        "enableServiceLinks": false,
        "restartPolicy": "Never",
        "securityContext": {
          "fsGroup": 65532,
          "runAsGroup": 65532,
          "runAsNonRoot": true,
          "runAsUser": 65532
        },
        "terminationGracePeriodSeconds": 2,
        "volumes": [
          {
            "emptyDir": {
              "sizeLimit": "256Mi"
            },
            "name": "work"
          }
        ]
      }
    },
