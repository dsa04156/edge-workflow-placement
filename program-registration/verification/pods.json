        "name": "edgeflow-demo-vision",
        "namespace": "topology-profile-lab",
        "labels": {
          "experiment": "topology-profile",
          "run-id": "edgeflow-demo",
          "task-id": "vision"
        }
      },
      "spec": {
        "schedulerName": "default-scheduler",
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "task",
            "image": "192.168.0.56:5000/node-inventory-python@sha256:370a8339507905053693d178e1cda8fbf77937f045ead58a3c32d8cead2ca67f",
            "resources": {
              "requests": {
                "cpu": "1010m",
                "memory": "2080Mi"
              }
            },
            "env": [
              {
                "name": "TASK_ID",
                "value": "vision"
              },
              {
                "name": "RUN_ID",
                "value": "edgeflow-demo"
              }
            ]
          }
        ],
        "affinity": {
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchFields": [
                    {
                      "key": "metadata.name",
                      "operator": "In",
                      "values": [
                        "etri-dev0003-raspi5"
                      ]
                    }
                  ]
                }
              ]
            }
