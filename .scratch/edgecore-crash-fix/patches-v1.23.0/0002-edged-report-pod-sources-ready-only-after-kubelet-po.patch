+// initPodReadyTimeout bounds how long edged waits for kubelet to take the
+// initial pod list into its podManager before reporting sources ready anyway.
+var initPodReadyTimeout = 2 * time.Minute
+
+// setInitPodReadyAfterKubeletAdmits reports pod sources ready only after
+// kubelet's podManager contains the initial pods. Kubelet's syncLoop skips pod
+// updates until the runtime/PLEG is healthy, so marking ready right after
+// queueing the list lets the volume populator finish with an empty desired
+// state and the reconciler tear down volumes of pods that are still running.
+func (e *edged) setInitPodReadyAfterKubeletAdmits(ctx context.Context, podCfg *config.PodConfig, expected sets.Set[types.UID]) {
+	if podCfg.SeenAllSources(nil) {
+		return
+	}
+	url := fmt.Sprintf("http://localhost:%d/pods", e.KubeletServer.ReadOnlyPort)
+	go func() {
+		waitCtx, cancel := context.WithTimeout(ctx, initPodReadyTimeout)
+		defer cancel()
+		err := wait.PollUntilContextCancel(waitCtx, 100*time.Millisecond, true, func(context.Context) (bool, error) {
+			return kubeletHasPods(url, expected), nil
+		})
+		if err != nil {
+			klog.Warningf("kubelet did not report all %d initial pods before timeout, marking pod sources ready anyway: %v", expected.Len(), err)
+		} else {
+			klog.Infof("kubelet reports all %d initial pods, marking pod sources ready", expected.Len())
+		}
+		podCfg.SetInitPodReady(true)
+	}()
+}
+
+// podManagerUIDs returns the UIDs kubelet's podManager.GetPods will report
+// for pods, which excludes mirror pods.
+func podManagerUIDs(pods []*v1.Pod) sets.Set[types.UID] {
+	uids := sets.New[types.UID]()
+	for _, pod := range pods {
+		if !kubelettypes.IsMirrorPod(pod) {
+			uids.Insert(pod.UID)
+		}
+	}
+	return uids
+}
+
+func kubeletHasPods(url string, expected sets.Set[types.UID]) bool {
+	if expected.Len() == 0 {
+		return true
+	}
+	resp, err := http.Get(url)
+	if err != nil {
+		klog.V(4).Infof("failed to get kubelet pods, err: %v", err)
+		return false
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return false
+	}
+	var list v1.PodList
+	if err := json.NewDecoder(resp.Body).Decode(&list); err != nil {
+		klog.V(4).Infof("failed to decode kubelet pods, err: %v", err)
+		return false
+	}
+	seen := sets.New[types.UID]()
+	for i := range list.Items {
+		seen.Insert(list.Items[i].UID)
+	}
+	return seen.IsSuperset(expected)
+}
