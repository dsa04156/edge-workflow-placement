+func init() {
+	beehiveContext.InitContext([]string{common.MsgCtxTypeChannel})
+	for _, m := range []string{modules.EdgedModuleName, modules.MetaManagerModuleName} {
+		beehiveContext.AddModule(&common.ModuleInfo{ModuleName: m, ModuleType: common.MsgCtxTypeChannel})
+	}
+}
+
+// TestInitPodReadyWaitsForKubeletPodManager reproduces the dev0009 restart
+// teardown: after an edgecore restart, metamanager answers the initial pod
+// list from sqlite within milliseconds, but kubelet's syncLoop does not read
+// pod updates while PLEG/runtime status is not yet healthy ("Skipping pod
+// synchronization"). If sources are reported ready in that window, the volume
+// desired-state populator finishes with an empty podManager and the reconciler
+// unmounts (and for emptyDir, deletes) every reconstructed volume of the
+// still-running pods.
+//
+// The property under test: SeenAllSources must stay false until kubelet's
+// podManager (served by the read-only /pods endpoint) contains the initial pods.
+func TestInitPodReadyWaitsForKubeletPodManager(t *testing.T) {
+	const nodeName = "edge-node"
+	running := &v1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: "source-e9", Namespace: "default", UID: "d4f764e3"},
+		Spec:       v1.PodSpec{NodeName: nodeName},
+	}
+	mirror := &v1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: "static-mirror", Namespace: "default", UID: "mirror-uid",
+			Annotations: map[string]string{kubelettypes.ConfigMirrorAnnotationKey: "x"}},
+		Spec: v1.PodSpec{NodeName: nodeName},
+	}
+
+	// Fake kubelet read-only server: /pods reflects podManager.GetPods(),
+	// which never contains mirror pods.
+	var admitted atomic.Bool
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/pods" {
+			http.NotFound(w, r)
+			return
+		}
+		list := v1.PodList{}
+		if admitted.Load() {
+			list.Items = []v1.Pod{*running}
+		}
+		_ = json.NewEncoder(w).Encode(list)
+	}))
+	defer srv.Close()
+
+	e := &edged{
+		nodeName:       nodeName,
+		namespace:      "default",
+		heldPodUpdates: map[string][]kubelettypes.PodUpdate{},
+		KubeletServer:  &kubeletoptions.KubeletServer{},
+	}
+	e.KubeletServer.ReadOnlyPort = int32(srv.Listener.Addr().(*net.TCPAddr).Port)
+
+	podCfg := config.NewPodConfig(config.PodConfigNotificationIncremental, record.NewFakeRecorder(10), kubeletutil.NewPodStartupLatencyTracker())
+	go e.syncPod(podCfg)
+
+	var items []string
+	for _, p := range []*v1.Pod{running, mirror} {
+		b, err := json.Marshal(p)
+		if err != nil {
+			t.Fatal(err)
+		}
+		items = append(items, string(b))
+	}
+	content, err := json.Marshal(items)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp := model.NewMessage("").BuildRouter(modules.MetaManagerModuleName, modules.MetaGroup,
+		"default/"+model.ResourceTypePod, model.ResponseOperation).FillBody(content)
+	beehiveContext.Send(modules.EdgedModuleName, *resp)
+
+	// Nobody consumes podCfg.Updates(): kubelet syncLoop is still skipping.
+	time.Sleep(700 * time.Millisecond)
+	if podCfg.SeenAllSources(nil) {
+		t.Fatalf("sources reported ready while kubelet podManager is still empty; volume reconciler would tear down live pod volumes")
+	}
+
+	admitted.Store(true)
+	deadline := time.Now().Add(5 * time.Second)
+	for !podCfg.SeenAllSources(nil) {
+		if time.Now().After(deadline) {
+			t.Fatalf("sources never became ready after kubelet admitted the initial pods")
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+}
+
+// TestInitPodReadyFallsBackAfterTimeout keeps upstream liveness: if kubelet
+// never reports a pod (e.g. it was filtered as invalid), sources still become
+// ready once initPodReadyTimeout expires.
+func TestInitPodReadyFallsBackAfterTimeout(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_ = json.NewEncoder(w).Encode(v1.PodList{})
+	}))
+	defer srv.Close()
+	old := initPodReadyTimeout
+	initPodReadyTimeout = 300 * time.Millisecond
+	defer func() { initPodReadyTimeout = old }()
+
+	e := &edged{KubeletServer: &kubeletoptions.KubeletServer{}}
+	e.KubeletServer.ReadOnlyPort = int32(srv.Listener.Addr().(*net.TCPAddr).Port)
+	podCfg := config.NewPodConfig(config.PodConfigNotificationIncremental, record.NewFakeRecorder(10), kubeletutil.NewPodStartupLatencyTracker())
+	e.setInitPodReadyAfterKubeletAdmits(context.Background(), podCfg, sets.New[types.UID]("never-admitted"))
+
+	time.Sleep(100 * time.Millisecond)
+	if podCfg.SeenAllSources(nil) {
+		t.Fatalf("sources ready before timeout")
+	}
+	deadline := time.Now().Add(3 * time.Second)
+	for !podCfg.SeenAllSources(nil) {
+		if time.Now().After(deadline) {
+			t.Fatalf("sources never became ready after timeout")
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+}
