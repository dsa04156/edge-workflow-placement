new file mode 100644
index 000000000..8614ab719
--- /dev/null
+++ b/pkg/stream/readchan.go
@@ -0,0 +1,53 @@
+package stream
+
+import "sync"
+
+// readChanGuard makes sends to a connection's ReadChan safe against the
+// connection being closed concurrently. Senders block while the consumer is
+// alive (no message is dropped in normal operation), but a close first
+// releases any blocked sender, so closing never panics a sender ("send on
+// closed channel") and never waits on a ReadChan whose consumer is gone, e.g.
+// when Serve fails before starting it. The zero value is ready to use.
+type readChanGuard struct {
+	initOnce  sync.Once
+	closeOnce sync.Once
+	done      chan struct{}
+
+	mu     sync.RWMutex
+	closed bool
+}
+
+func (g *readChanGuard) doneChan() chan struct{} {
+	g.initOnce.Do(func() { g.done = make(chan struct{}) })
+	return g.done
+}
+
+// send delivers msg to ch, blocking until it is received or the guard is
+// closed. It reports whether msg was delivered.
+func (g *readChanGuard) send(ch chan *Message, msg *Message) bool {
+	done := g.doneChan()
+	g.mu.RLock()
+	defer g.mu.RUnlock()
+	if g.closed {
+		return false
+	}
+	select {
+	case ch <- msg:
+		return true
+	case <-done:
+		return false
+	}
+}
+
+// close releases blocked senders, waits for in-flight sends to return and
+// closes ch so the consumer's range loop ends. It is idempotent.
+func (g *readChanGuard) close(ch chan *Message) {
+	done := g.doneChan()
+	g.closeOnce.Do(func() {
+		close(done)
+		g.mu.Lock()
+		defer g.mu.Unlock()
+		g.closed = true
+		close(ch)
+	})
+}
