--- /dev/null
+++ b/edge/pkg/edgestream/tunnel_lifecycle_test.go
@@ -0,0 +1,300 @@
+package edgestream
+
+import (
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/http"
+	"net/url"
+	"runtime"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/kubeedge/kubeedge/pkg/stream"
+)
+
+type connCase struct {
+	name string
+	new  func(readCap int) (stream.EdgedConnection, chan *stream.Message)
+}
+
+var connCases = []connCase{
+	{"exec", func(n int) (stream.EdgedConnection, chan *stream.Message) {
+		c := &stream.EdgedExecConnection{ReadChan: make(chan *stream.Message, n), Stop: make(chan struct{}, 2)}
+		return c, c.ReadChan
+	}},
+	{"attach", func(n int) (stream.EdgedConnection, chan *stream.Message) {
+		c := &stream.EdgedAttachConnection{ReadChan: make(chan *stream.Message, n), Stop: make(chan struct{}, 2)}
+		return c, c.ReadChan
+	}},
+	{"logs", func(n int) (stream.EdgedConnection, chan *stream.Message) {
+		c := &stream.EdgedLogsConnection{ReadChan: make(chan *stream.Message, n), Stop: make(chan struct{}, 2)}
+		return c, c.ReadChan
+	}},
+	{"metrics", func(n int) (stream.EdgedConnection, chan *stream.Message) {
+		c := &stream.EdgedMetricsConnection{ReadChan: make(chan *stream.Message, n), Stop: make(chan struct{}, 2)}
+		return c, c.ReadChan
+	}},
+}
+
+func waitDone(t *testing.T, what string, ch <-chan struct{}, d time.Duration) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(d):
+		t.Fatalf("%s did not finish within %v (deadlock/stall)", what, d)
+	}
+}
+
+// writeRecover runs WriteToLocalConnection and reports a panic instead of
+// crashing the test binary.
+func writeRecover(s *TunnelSession, m *stream.Message) (p interface{}) {
+	defer func() { p = recover() }()
+	s.WriteToLocalConnection(m)
+	return nil
+}
+
+// TestDeleteWithFullBufferAndNoConsumer: the tunnel reader is blocked in
+// CacheTunnelMessage on a full ReadChan whose consumer never started (e.g. exec
+// dial failed). DeleteLocalConnection must neither panic the sender (v1.23.0)
+// nor deadlock against it (PR #6836 holds localConsLock across the send).
+func TestDeleteWithFullBufferAndNoConsumer(t *testing.T) {
+	for _, tc := range connCases {
+		t.Run(tc.name, func(t *testing.T) {
+			s := &TunnelSession{localCons: make(map[uint64]stream.EdgedConnection)}
+			con, rc := tc.new(1)
+			s.AddLocalConnection(1, con)
+			rc <- stream.NewMessage(1, stream.MessageTypeData, []byte("fill"))
+
+			writerDone := make(chan struct{})
+			var p interface{}
+			go func() {
+				defer close(writerDone)
+				p = writeRecover(s, stream.NewMessage(1, stream.MessageTypeData, []byte("blocked")))
+			}()
+			time.Sleep(50 * time.Millisecond)
+
+			delDone := make(chan struct{})
+			go func() { defer close(delDone); s.DeleteLocalConnection(1) }()
+			waitDone(t, "DeleteLocalConnection", delDone, 3*time.Second)
+			waitDone(t, "blocked writer", writerDone, 3*time.Second)
+			if p != nil {
+				t.Fatalf("writer panicked: %v", p)
+			}
+			// other connections keep working: the session lock is free.
+			lockFree := make(chan struct{})
+			go func() { defer close(lockFree); s.AddLocalConnection(2, con) }()
+			waitDone(t, "AddLocalConnection after delete", lockFree, time.Second)
+		})
+	}
+}
+
+// TestExecDialFailureWithFullBuffer drives the real ServeConnection path: the
+// exec dial hangs (server accepts but never completes TLS), the cloud keeps sending
+// stdin until ReadChan (128) is full and the tunnel reader blocks, then the
+// dial fails. Serve returns before receiveFromCloudStream ever started.
+func TestExecDialFailureWithFullBuffer(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var mu sync.Mutex
+	var accepted []net.Conn
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			mu.Lock()
+			accepted = append(accepted, c)
+			mu.Unlock()
+		}
+	}()
+
+	const id = 42
+	execInfo := &stream.EdgedExecConnection{
+		MessID: id,
+		// https: the TLS handshake blocks against the silent server, so the
+		// dial is in progress (no consumer yet) until we close the server.
+		URL:    url.URL{Scheme: "https", Host: ln.Addr().String(), Path: "/exec/ns/pod/c"},
+		Header: http.Header{},
+		Method: http.MethodPost,
+	}
+	data, err := json.Marshal(execInfo)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := &TunnelSession{localCons: make(map[uint64]stream.EdgedConnection)}
+	serveDone := make(chan struct{})
+	go func() {
+		defer close(serveDone)
+		s.ServeConnection(stream.NewMessage(id, stream.MessageTypeExecConnect, data))
+	}()
+
+	var con stream.EdgedConnection
+	for deadline := time.Now().Add(3 * time.Second); ; {
+		var ok bool
+		if con, ok = s.GetLocalConnection(id); ok {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("exec connection never registered")
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	rc := con.(*stream.EdgedExecConnection).ReadChan
+
+	writerDone := make(chan struct{})
+	var p interface{}
+	go func() {
+		defer close(writerDone)
+		for i := 0; i < cap(rc)+16 && p == nil; i++ {
+			p = writeRecover(s, stream.NewMessage(id, stream.MessageTypeData, []byte(fmt.Sprint(i))))
+		}
+	}()
+	for deadline := time.Now().Add(3 * time.Second); len(rc) < cap(rc); {
+		if time.Now().After(deadline) {
+			serveFinished := false
+			select {
+			case <-serveDone:
+				serveFinished = true
+			default:
+			}
+			buf := make([]byte, 1<<20)
+			n := runtime.Stack(buf, true)
+			t.Fatalf("ReadChan never filled: len=%d serveFinished=%v writerPanic=%v\n%s", len(rc), serveFinished, p, buf[:n])
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	time.Sleep(50 * time.Millisecond) // writer is now blocked on the full channel
+
+	// make the dial fail
+	_ = ln.Close()
+	mu.Lock()
+	for _, c := range accepted {
+		_ = c.Close()
+	}
+	mu.Unlock()
+
+	waitDone(t, "ServeConnection", serveDone, 5*time.Second)
+	waitDone(t, "tunnel writer", writerDone, 5*time.Second)
+	if p != nil {
+		t.Fatalf("tunnel writer panicked: %v", p)
+	}
+	if _, ok := s.GetLocalConnection(id); ok {
+		t.Fatal("connection still registered")
+	}
+}
+
+// TestNoDropWithLiveConsumer: with a slow but live consumer every message is
+// delivered in order (backpressure, no dropping in the normal path).
+func TestNoDropWithLiveConsumer(t *testing.T) {
+	for _, tc := range connCases {
+		t.Run(tc.name, func(t *testing.T) {
+			s := &TunnelSession{localCons: make(map[uint64]stream.EdgedConnection)}
+			con, rc := tc.new(2)
+			s.AddLocalConnection(1, con)
+			const n = 500
+			got := make(chan []string, 1)
+			go func() {
+				var out []string
+				for m := range rc {
+					out = append(out, string(m.Data))
+					if len(out)%50 == 0 {
+						time.Sleep(time.Millisecond)
+					}
+				}
+				got <- out
+			}()
+			for i := 0; i < n; i++ {
+				if p := writeRecover(s, stream.NewMessage(1, stream.MessageTypeData, []byte(fmt.Sprint(i)))); p != nil {
+					t.Fatalf("panic: %v", p)
+				}
+			}
+			s.DeleteLocalConnection(1)
+			var out []string
+			select {
+			case out = <-got:
+			case <-time.After(3 * time.Second):
+				t.Fatal("consumer did not finish: ReadChan not closed after delete")
+			}
+			if len(out) != n {
+				t.Fatalf("delivered %d of %d messages", len(out), n)
+			}
+			for i, v := range out {
+				if v != fmt.Sprint(i) {
+					t.Fatalf("message %d out of order: %q", i, v)
+				}
+			}
+		})
+	}
+}
+
+// TestCloseReadChannelIdempotent: double close and send-after-close are safe.
+func TestCloseReadChannelIdempotent(t *testing.T) {
+	for _, tc := range connCases {
+		t.Run(tc.name, func(t *testing.T) {
+			con, _ := tc.new(1)
+			func() {
+				defer func() {
+					if p := recover(); p != nil {
+						t.Fatalf("panic: %v", p)
+					}
+				}()
+				con.CloseReadChannel()
+				con.CloseReadChannel()
+				done := make(chan struct{})
+				go func() {
+					defer close(done)
+					con.CacheTunnelMessage(stream.NewMessage(1, stream.MessageTypeData, nil))
+				}()
+				waitDone(t, "CacheTunnelMessage after close", done, time.Second)
+			}()
+		})
+	}
+}
+
+// TestConcurrentWriteDelete hammers lookup+send against delete with consumers
+// that may or may not be running; run with -race.
+func TestConcurrentWriteDelete(t *testing.T) {
+	s := &TunnelSession{localCons: make(map[uint64]stream.EdgedConnection)}
+	var panics sync.Map
+	var wg sync.WaitGroup
+	for i := uint64(0); i < 400; i++ {
+		tc := connCases[i%uint64(len(connCases))]
+		con, rc := tc.new(2)
+		s.AddLocalConnection(i, con)
+		if i%2 == 0 {
+			go func() {
+				for range rc {
+				}
+			}()
+		}
+		wg.Add(3)
+		for w := 0; w < 2; w++ {
+			go func(id uint64) {
+				defer wg.Done()
+				for j := 0; j < 8; j++ {
+					if p := writeRecover(s, stream.NewMessage(id, stream.MessageTypeData, []byte("x"))); p != nil {
+						panics.Store(id, fmt.Sprint(p))
+						return
+					}
+				}
+			}(i)
+		}
+		go func(id uint64) {
+			defer wg.Done()
+			s.DeleteLocalConnection(id)
+			s.DeleteLocalConnection(id)
+		}(i)
+	}
+	done := make(chan struct{})
+	go func() { wg.Wait(); close(done) }()
+	waitDone(t, "concurrent writers/deletes", done, 10*time.Second)
+	panics.Range(func(k, v interface{}) bool {
+		t.Errorf("connection %v panicked: %v", k, v)
+		return true
+	})
+}
