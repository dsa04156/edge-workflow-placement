diff --git a/edge/pkg/edged/sources_ready_test.go b/edge/pkg/edged/sources_ready_test.go
new file mode 100644
index 000000000..f96d327ee
--- /dev/null
+++ b/edge/pkg/edged/sources_ready_test.go
@@ -0,0 +1,219 @@
+package edged
+
+import (
+	"encoding/json"
+	"os"
+	"os/exec"
+	"testing"
+	"time"
+
+	v1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/types"
+	"k8s.io/client-go/tools/record"
+	"k8s.io/kubernetes/pkg/kubelet/config"
+	kubelettypes "k8s.io/kubernetes/pkg/kubelet/types"
+	kubeletutil "k8s.io/kubernetes/pkg/kubelet/util"
+
+	"github.com/kubeedge/beehive/pkg/common"
+	beehiveContext "github.com/kubeedge/beehive/pkg/core/context"
+	"github.com/kubeedge/beehive/pkg/core/model"
+	"github.com/kubeedge/kubeedge/edge/pkg/common/modules"
+)
+
+// These tests reproduce the dev0009 restart teardown with the real edged
+// syncPod loop and the real (vendored kubeedge fork) kubelet PodConfig and
+// SourcesReady. Only kubelet's syncLoop is simulated, exactly as in
+// Kubelet.syncLoopIteration: take one update from PodConfig.Updates(),
+// apply it to the pod manager, then sourcesReady.AddSource(u.Source). The
+// volume populator finishes its initial pass as soon as AllReady() is true,
+// so AllReady() must never be true while podManager misses an initial pod.
+//
+// syncPod listens on the global beehive "edged" queue and never returns, so
+// every scenario runs in its own test process.
+
+const isolatedEnv = "EDGED_SOURCES_READY_CASE"
+
+func runIsolated(t *testing.T) bool {
+	if os.Getenv(isolatedEnv) == t.Name() {
+		return true
+	}
+	cmd := exec.Command(os.Args[0], "-test.run=^"+t.Name()+"$", "-test.v")
+	cmd.Env = append(os.Environ(), isolatedEnv+"="+t.Name())
+	out, err := cmd.CombinedOutput()
+	t.Logf("isolated run output:\n%s", out)
+	if err != nil {
+		t.Fatalf("isolated run failed: %v", err)
+	}
+	return false
+}
+
+const testNode = "edge-node"
+
+type fakeKubelet struct {
+	t            *testing.T
+	podCfg       *config.PodConfig
+	sourcesReady config.SourcesReady
+	podManager   map[types.UID]string
+}
+
+func startEdged(t *testing.T) *fakeKubelet {
+	beehiveContext.InitContext([]string{common.MsgCtxTypeChannel})
+	for _, m := range []string{modules.EdgedModuleName, modules.MetaManagerModuleName} {
+		beehiveContext.AddModule(&common.ModuleInfo{ModuleName: m, ModuleType: common.MsgCtxTypeChannel})
+	}
+	podCfg := config.NewPodConfig(config.PodConfigNotificationIncremental, record.NewFakeRecorder(100), kubeletutil.NewPodStartupLatencyTracker())
+	k := &fakeKubelet{
+		t:            t,
+		podCfg:       podCfg,
+		sourcesReady: config.NewSourcesReady(podCfg.SeenAllSources), // as kubelet.NewMainKubelet
+		podManager:   map[types.UID]string{},
+	}
+	// kubelet's makePodSourceConfig registers the static pod file source,
+	// which sends an (empty) SET on its first listing.
+	fileCh := podCfg.Channel(beehiveContext.GetContext(), kubelettypes.FileSource)
+	fileCh <- kubelettypes.PodUpdate{Op: kubelettypes.SET, Source: kubelettypes.FileSource}
+
+	e := &edged{nodeName: testNode, namespace: "default", heldPodUpdates: map[string][]kubelettypes.PodUpdate{}}
+	go e.syncPod(podCfg)
+	return k
+}
+
+// step applies one update the way syncLoopIteration does.
+func (k *fakeKubelet) step(timeout time.Duration) (kubelettypes.PodUpdate, bool) {
+	select {
+	case u := <-k.podCfg.Updates():
+		for _, p := range u.Pods {
+			switch u.Op {
+			case kubelettypes.ADD, kubelettypes.UPDATE, kubelettypes.DELETE:
+				k.podManager[p.UID] = p.Name
+			case kubelettypes.REMOVE:
+				delete(k.podManager, p.UID)
+			}
+		}
+		k.sourcesReady.AddSource(u.Source)
+		return u, true
+	case <-time.After(timeout):
+		return kubelettypes.PodUpdate{}, false
+	}
+}
+
+// drainUntilReady runs the syncLoop simulation until AllReady and asserts the
+// populator invariant at every point where readiness could be observed.
+func (k *fakeKubelet) drainUntilReady(required ...types.UID) {
+	deadline := time.Now().Add(5 * time.Second)
+	for !k.sourcesReady.AllReady() {
+		if time.Now().After(deadline) {
+			k.t.Fatalf("sources never became ready (podManager=%v)", k.podManager)
+		}
+		k.step(50 * time.Millisecond)
+	}
+	for _, uid := range required {
+		if _, ok := k.podManager[uid]; !ok {
+			k.t.Fatalf("sources ready while initial pod %s is not in podManager (%v): volume reconciler would tear down its volumes", uid, k.podManager)
+		}
+	}
+}
+
+func pod(name string, uid types.UID) *v1.Pod {
+	return &v1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: "default", UID: uid},
+		Spec:       v1.PodSpec{NodeName: testNode},
+	}
+}
+
+func sendPodList(t *testing.T, pods ...*v1.Pod) {
+	items := []string{}
+	for _, p := range pods {
+		b, err := json.Marshal(p)
+		if err != nil {
+			t.Fatal(err)
+		}
+		items = append(items, string(b))
+	}
+	content, err := json.Marshal(items)
+	if err != nil {
+		t.Fatal(err)
+	}
+	msg := model.NewMessage("").BuildRouter(modules.MetaManagerModuleName, modules.MetaGroup,
+		"default/"+model.ResourceTypePod, model.ResponseOperation).FillBody(content)
+	beehiveContext.Send(modules.EdgedModuleName, *msg)
+}
+
+func sendPodOp(t *testing.T, op string, p *v1.Pod) {
+	b, err := json.Marshal(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	msg := model.NewMessage("").BuildRouter("edgecontroller", "resource",
+		"default/"+model.ResourceTypePod+"/"+p.Name, op).FillBody(b)
+	beehiveContext.Send(modules.EdgedModuleName, *msg)
+}
+
+// Kubelet syncLoop is skipping (PLEG not healthy) when the list arrives:
+// sources must stay not ready however long that lasts (no fail-open timeout),
+// and become ready only once kubelet has processed the initial pods.
+func TestSourcesNotReadyUntilKubeletProcessesInitialPods(t *testing.T) {
+	if !runIsolated(t) {
+		return
+	}
+	k := startEdged(t)
+	sendPodList(t, pod("source-e9", "uid-a"), pod("sink-e9", "uid-b"))
+
+	for i := 0; i < 15; i++ { // 1.5s of "Skipping pod synchronization"
+		time.Sleep(100 * time.Millisecond)
+		if k.sourcesReady.AllReady() {
+			t.Fatalf("sources ready after %dms while kubelet has processed no pod updates", (i+1)*100)
+		}
+	}
+	k.drainUntilReady("uid-a", "uid-b") // late recovery
+}
+
+// A pod update from the cloud that arrives before the metamanager list must
+// not let readiness overtake the initial list.
+func TestPreListPodUpdateDoesNotOpenWindow(t *testing.T) {
+	if !runIsolated(t) {
+		return
+	}
+	k := startEdged(t)
+	sendPodOp(t, model.UpdateOperation, pod("early", "uid-early"))
+	time.Sleep(100 * time.Millisecond)
+	sendPodList(t, pod("source-e9", "uid-a"))
+	time.Sleep(100 * time.Millisecond)
+
+	k.drainUntilReady("uid-a")
+	// the early update is not lost
+	deadline := time.Now().Add(3 * time.Second)
+	for {
+		if _, ok := k.podManager["uid-early"]; ok {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("pre-list pod update was dropped (podManager=%v)", k.podManager)
+		}
+		k.step(50 * time.Millisecond)
+	}
+}
+
+// No dependence on pod identity: an empty list, a stale pod deleted right
+// after the list, and a duplicate-name pod that kubelet's config filters out
+// must all reach readiness (no permanent stall).
+func TestNoStallOnEmptyStaleOrFilteredPods(t *testing.T) {
+	if !runIsolated(t) {
+		return
+	}
+	k := startEdged(t)
+	dup := pod("source-e9", "uid-dup") // same full name: filtered as invalid
+	sendPodList(t, pod("source-e9", "uid-a"), dup, pod("stale", "uid-stale"))
+	sendPodOp(t, model.DeleteOperation, pod("stale", "uid-stale"))
+	k.drainUntilReady("uid-a")
+}
+
+func TestNoStallOnEmptyList(t *testing.T) {
+	if !runIsolated(t) {
+		return
+	}
+	k := startEdged(t)
+	sendPodList(t)
+	k.drainUntilReady()
+}
