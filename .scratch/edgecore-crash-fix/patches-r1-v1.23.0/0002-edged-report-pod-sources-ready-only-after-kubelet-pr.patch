--- a/vendor/k8s.io/kubernetes/pkg/kubelet/config/config.go
+++ b/vendor/k8s.io/kubernetes/pkg/kubelet/config/config.go
@@ -105,10 +105,24 @@ func (c *PodConfig) Channel(ctx context.Context, source string) chan<- interface
 
 // SeenAllSources returns true if seenSources contains all sources in the
 // config, and also this config has received a SET message from each source.
+//
+// KubeEdge: edged additionally reports initPodReady once it has queued the
+// initial pod list. initPodReady alone is not enough: kubelet's syncLoop does
+// not consume pod updates until the runtime is healthy, and readiness before
+// that lets the volume manager unmount volumes of running pods. So keep the
+// upstream check that kubelet has processed an update from every source
+// (seenSources, recorded by syncLoopIteration) and that each source has sent
+// its first SET.
 func (c *PodConfig) SeenAllSources(seenSources sets.Set[string]) bool {
 	c.podReadyLock.RLock()
-	defer c.podReadyLock.RUnlock()
-	return c.initPodReady
+	initPodReady := c.initPodReady
+	c.podReadyLock.RUnlock()
+	if !initPodReady || c.pods == nil {
+		return false
+	}
+	c.sourcesLock.Lock()
+	defer c.sourcesLock.Unlock()
+	return seenSources.HasAll(sets.List(c.sources)...) && c.pods.seenSources(sets.List(c.sources)...)
 }
 
 // SetInitPodReady is used to safely set initPodReady flag
@@ -333,6 +347,12 @@ func (s *podStorage) markSourceSet(source string) {
 	s.sourcesSeen.Insert(source)
 }
 
+func (s *podStorage) seenSources(sources ...string) bool {
+	s.sourcesSeenLock.RLock()
+	defer s.sourcesSeenLock.RUnlock()
+	return s.sourcesSeen.HasAll(sources...)
+}
