{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "dev0009-registry-fix-probe",
    "namespace": "topology-profile-lab",
    "labels": {
      "run-id": "dev0009-registry-fix-20261022"
    }
  },
  "spec": {
    "nodeSelector": {
      "kubernetes.io/hostname": "etri-dev0009-jetorn"
    },
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "activeDeadlineSeconds": 180,
    "terminationGracePeriodSeconds": 1,
    "containers": [
      {
        "name": "probe",
        "image": "10.254.192.47:5000/node-inventory-python@sha256:370a8339507905053693d178e1cda8fbf77937f045ead58a3c32d8cead2ca67f",
        "imagePullPolicy": "Always",
        "command": [
          "python3",
          "-c",
          "import platform;print(\"REGISTRY_IMAGE_OK\",platform.machine())"
        ],
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "32Mi"
          },
          "limits": {
            "cpu": "100m",
            "memory": "128Mi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        }
      }
    ]
  }
}